# ─── Frontend Environment Variables (.env) ─────────────────────────────────
# Copy this file to .env and fill in the values.
#
# SECURITY: Only put PUBLIC values here. Every variable starting with VITE_
# is embedded into the browser JavaScript bundle and is visible to anyone.
#
# NEVER put these in a VITE_ variable (use server/.env / Render instead):
#   JWT_SECRET, MONGODB_URI, XENDIT_SECRET_KEY, RESEND_API_KEY, passwords

# Base URL for the REST API that serves booking data.
# In development the Vite dev server proxies /api → http://localhost:5001
# so you can leave this blank or set it to /api.
# In production, set this to your deployed API URL.
VITE_API_URL=https://madyaw-api.onrender.com/api

# Google OAuth client ID — same value as server GOOGLE_CLIENT_ID.
# This is a PUBLIC identifier (not a secret). Still restrict authorised
# JavaScript origins / redirect URIs in Google Cloud Console.
# Required for the Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Optional: Enable verbose API request logging in the browser console.
# Set to "true" to turn on.
VITE_DEBUG_API=false

# Optional public store URLs for the homepage “Install the app” membership banner.
# Leave blank to show App Store / Google Play as coming soon.
# VITE_IOS_APP_URL=https://apps.apple.com/app/idYOUR_APP_ID
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=YOUR_PACKAGE

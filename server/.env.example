# ─── Server Environment Variables (server/.env) ─────────────────────────────
# Copy this file to server/.env and fill in ALL values before starting the server.
# NEVER commit server/.env to source control — it is already in .gitignore.

# ── Server port ──────────────────────────────────────────────────────────────
PORT=5001

# ── JWT auth ─────────────────────────────────────────────────────────────────
# OWASP A02: JWT_SECRET must be a cryptographically random string.
#
# REQUIRED: Generate before first run and rotate at least every 90 days:
#   openssl rand -hex 64
#
# The server will REFUSE TO START if this is left as a placeholder or is
# shorter than 32 characters. This check runs in ALL environments (not just prod).
JWT_SECRET=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_64

# How long access tokens are valid (e.g. 15m, 1h, 7d).
# Keep short in production to limit the window for stolen tokens.
JWT_EXPIRES_IN=7d

# ── CORS allowlist ───────────────────────────────────────────────────────────
# The exact origin the browser will use to reach the frontend.
# No trailing slash. In production set this to your actual domain.
CLIENT_ORIGIN=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Your Google Cloud Console OAuth 2.0 client ID.
# This is a PUBLIC identifier — not a secret. However:
#   - Restrict authorised origins/redirect URIs in Google Cloud Console.
#   - Never use the production client ID in local dev if possible.
# Required for the POST /api/auth/google endpoint.
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB connection string.
# SECURITY REMINDERS:
#   - Use a dedicated DB user with the minimum required permissions (readWrite only).
#   - Rotate the password immediately if it has ever appeared in source control or logs.
#   - For Atlas: restrict access to your server's IP in the Network Access settings.
#   - For local: mongodb://localhost:27017/madyaw_booking
MONGODB_URI=mongodb://localhost:27017/madyaw_booking

# ── Node environment ─────────────────────────────────────────────────────────
# Set to "production" in deployment to enable:
#   - Secure, SameSite=none cookies for cross-origin SPA ↔ API
#   - Strict rate limits (lower per-IP ceilings)
#   - All startup security checks at their strictest
NODE_ENV=development

# ── Optional: real email delivery (Resend) ───────────────────────────────────
# SERVER-ONLY secret. Never prefix with VITE_ and never put in the frontend .env.
# When unset, confirmation emails are logged to the server console and marked failed.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Madyaw Bookings <noreply@yourdomain.com>

# ── Optional: real online payments (Xendit) ──────────────────────────────────
# SERVER-ONLY secret. Never prefix with VITE_ and never put in the frontend .env.
# When unset, checkout returns mode=unavailable and bookings stay request-to-book.
# XENDIT_SECRET_KEY=xnd_production_or_development_key

# ── Optional: hotel → website approval sync ──────────────────────────────────
# Shared secret for POST /api/bookings/hotel-events (Authorization: Bearer …).
# Generate with: openssl rand -hex 32
# HOTEL_WEBHOOK_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
#
# Mongo change stream watcher on external_reservations (Atlas replica set).
# Default: enabled outside test. Set false to rely on the webhook only.
# ENABLE_EXTERNAL_RESERVATION_WATCHER=true

# ── Key rotation policy ──────────────────────────────────────────────────────
# JWT_SECRET    — rotate every 90 days or immediately after any suspected leak.
# MONGODB_URI   — rotate the DB user password immediately if leaked; update Atlas
#                 IP allowlist on every infrastructure change.
# GOOGLE_CLIENT_ID — public ID; revoke/regenerate in Google Cloud if misused.
# RESEND_API_KEY / XENDIT_SECRET_KEY / HOTEL_WEBHOOK_SECRET — rotate if leaked.
# Never commit real .env files. Never expose secrets via VITE_* (public bundle).